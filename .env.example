# Copy to .env and fill in. Never commit .env.
# Real environment variables take precedence over values in this file.

# --- Secrets (needed from Phase 2 onward) ---------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional local fallback (no key needed): run `ollama serve` and use model "ollama/llama3.1"

# --- Optional overrides (non-secret; leave blank to use the pinned defaults in db.py) --
# Northwind source dump. Override BOTH together: the hash must match the file at the URL.
NORTHWIND_SOURCE_URL=
NORTHWIND_SOURCE_SHA256=
# Path of the built DuckDB file (default: data/northwind.duckdb)
EVAL_HARNESS_DB=
